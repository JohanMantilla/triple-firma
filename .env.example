# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Only needed for live extraction (npm run demo:live). Leave empty to use the cache.
ANTHROPIC_API_KEY=

# Your own Turso database (one per developer: npm run demo resets it). Steps in README.md.
# Offline Plan B: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret for PUT /api/config and POST /api/approvals (header x-api-key). Required in production:
# without it those routes answer 401. Optional in development.
HUMAN_ACTIONS_KEY=

# true: the frontend uses src/lib/mocks instead of calling the API.
NEXT_PUBLIC_USE_MOCK_API=true
