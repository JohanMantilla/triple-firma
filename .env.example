# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Only needed for live extraction (npm run demo:live). Leave empty to use the cache.
ANTHROPIC_API_KEY=

# Local development uses a file. The deploy points to Turso (libsql://...).
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# true: the frontend uses src/lib/mocks instead of calling the API.
NEXT_PUBLIC_USE_MOCK_API=true
